{
 "uid": "canteen-lb",
 "title": "canteen / Load balancing: replicas behind Envoy (A3)",
 "tags": [
  "canteen",
  "a3",
  "envoy"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "description": "Assignment 3: per-replica request rate and share, active requests, p50/p95 (1 m window) and errors for HTTP and gRPC, plus Envoy's cluster health and upstream stats. Replicas are scraped directly (labels replica=A|B|C in prometheus.yml).",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "HTTP: per replica",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "HTTP requests/s by replica (1m)",
   "description": "rate() over 1m of the requests each replica handled, from its own /metrics (scraped directly, label `replica` set by Prometheus). Health checks are excluded.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 9,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (replica) (rate(canteen_http_requests_total{route!~\"/health|/metrics\"}[1m]))",
     "legendFormat": "{{replica}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "HTTP share of traffic by replica, % (1m)",
   "description": "Each replica's rate divided by the total: the number to compare with 100/0/0 (A only), 33/33/33 (round robin) and 50/25/25 (weights 2:1:1).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 9,
    "y": 1,
    "w": 9,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum by (replica) (rate(canteen_http_requests_total{route!~\"/health|/metrics\"}[1m])) / scalar(sum(rate(canteen_http_requests_total{route!~\"/health|/metrics\"}[1m])))",
     "legendFormat": "{{replica}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "bargauge",
   "title": "HTTP share over the selected time range, %",
   "description": "increase() over the dashboard's whole time range: set the range to one run's window and read the shares for the results table.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum by (replica) (increase(canteen_http_requests_total{route!~\"/health|/metrics\"}[$__range])) / scalar(sum(increase(canteen_http_requests_total{route!~\"/health|/metrics\"}[$__range])))",
     "legendFormat": "{{replica}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   }
  },
  {
