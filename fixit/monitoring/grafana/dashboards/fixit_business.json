{
 "uid": "fixit-business",
 "title": "fixit / Business",
 "tags": [
  "fixit",
  "business"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Tasks in progress",
   "description": "Gauge: concurrent agent runs right now (inc at task start, dec at end).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "fixit_tasks_in_progress",
     "legendFormat": "in progress",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "center"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Task success rate (10m window)",
   "description": "Share of finished tasks whose outcome was success over the last 10 minutes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(fixit_tasks_total{outcome=\"success\"}[10m])) / sum(rate(fixit_tasks_total[10m]))",
     "legendFormat": "success",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "green",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "center"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Cost per hour (USD, from 5m rate)",
   "description": "Current LLM spend extrapolated to one hour. Mock uses the real claude-sonnet-4-6 price table.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(fixit_llm_cost_usd_total[5m])) * 3600",
     "legendFormat": "$/h",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "center"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Tasks finished (last 1h)",
   "description": "Total tasks finished in the last hour, any outcome.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(fixit_tasks_total[1h]))",
     "legendFormat": "tasks",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "center"
   }
  },
  {
   "id": 5,
   "type": "barchart",
   "title": "Tasks completed by outcome (last 1h)",
   "description": "success / failed / aborted / error counts over the last hour.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (increase(fixit_tasks_total[1h]))",
     "legendFormat": "{{outcome}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "auto",
    "showValue": "always",
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "xTickLabelRotation": 0
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Task duration p95 by outcome (5m window)",
   "description": "End-to-end time to fix. Mock baseline ~2 s (5 LLM calls x 0.2 s + 2 pytest runs). Slow fault adds 3 s per affected call.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(fixit_task_duration_seconds_bucket[5m])))",
     "legendFormat": "{{outcome}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "heatmap",
   "title": "Iterations per task (heatmap of fixit_task_iterations)",
   "description": "Self-explored metric: distribution of agent loop iterations per task. A band at 5 = healthy mock. Drift toward 8-10 = the agent is thrashing / hitting the cap.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (le) (increase(fixit_task_iterations_bucket[5m]))",
     "legendFormat": "{{le}}",
     "refId": "A",
     "range": true,
     "format": "heatmap"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "calculate": false,
    "yAxis": {
     "unit": "short",
     "axisLabel": "iterations (le)"
    },
    "color": {
     "mode": "scheme",
     "scheme": "Oranges",
     "steps": 32
    },
    "cellGap": 1,
    "tooltip": {
     "mode": "single",
     "yHistogram": true
    },
    "legend": {
     "show": true
    },
    "exemplars": {
     "color": "rgba(255,0,255,0.7)"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Cumulative LLM tokens",
   "description": "Raw counter values: total input and output tokens since the agent started (resets on restart).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (direction) (fixit_llm_tokens_total)",
     "legendFormat": "{{direction}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Sandbox test runs/s by result",
   "description": "pytest executions inside the sandbox: passed / failed / timeout.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(fixit_sandbox_test_runs_total[5m]))",
     "legendFormat": "{{result}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Tasks/s by outcome",
   "description": "Task throughput per second by outcome.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (rate(fixit_tasks_total[5m]))",
     "legendFormat": "{{outcome}}",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}