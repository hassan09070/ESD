# Copy to .env (gitignored). Everything works with the defaults and no API key.
ANTHROPIC_API_KEY=
# mock      = deterministic scripted LLM (free, repeatable; only knows the sample repo)
# ollama    = local model via Ollama on the host (free, real reasoning)   -> `ollama pull qwen2.5-coder:7b`
# anthropic = Claude via the Messages API (needs ANTHROPIC_API_KEY)
FIXIT_LLM=mock
# Ollama settings (only used when FIXIT_LLM=ollama)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
# Fault injection for Part E.1: none | slow (every 5th LLM call sleeps +3 s) | flaky (every 5th LLM call raises).
FIXIT_FAULT=none
# Repository the agent works on (bind-mounted at /workspace in the container).
FIXIT_REPO=./sample_repo
# Cardinality experiment (Part E.2): 1 = label the throwaway demo counter with run_id.
FIXIT_DEMO_CARDINALITY=0
