# Copy to .env (gitignored). Everything works with the defaults and no API key.
ANTHROPIC_API_KEY=
# mock  = deterministic scripted LLM (free, repeatable). anthropic = real Claude via the Messages API.
FIXIT_LLM=mock
# Fault injection for Part E.1: none | slow (every 5th LLM call sleeps +3 s) | flaky (every 5th LLM call raises).
FIXIT_FAULT=none
# Cardinality experiment (Part E.2): 1 = label the throwaway demo counter with run_id.
FIXIT_DEMO_CARDINALITY=0
