# Copy to .env (gitignored). Everything works with the defaults.
# Fault injection for Part E.1 (re-create the api to apply: `docker compose up -d api`):
#   none       = normal
#   cold_start = warm pool disabled + every spawn sleeps TERMLAB_FAULT_SPAWN_DELAY_S (default 2.0)
#   cpu_hog    = TERMLAB_HOG_COUNT unlimited stress-ng containers compete with user sandboxes
TERMLAB_FAULT=none
# Capacity: running user sandboxes / pre-created warm sandboxes / idle reap / queue wait.
TERMLAB_POOL_SIZE=10
TERMLAB_WARM_POOL_SIZE=2
TERMLAB_IDLE_TIMEOUT_S=900
TERMLAB_QUEUE_TIMEOUT_S=60
TERMLAB_HOG_COUNT=4
# Cardinality experiment (Part E.2): 1 = label the throwaway demo counter with request_id.
TERMLAB_DEMO_CARDINALITY=0
